# Copy to .env for LOCAL builds only. .env is git-ignored.
# Only PUBLIC values belong here. Never put a service-role key, secret key or
# database password in this file, in the frontend, or in GitHub.
AVORA_ENV=development
AVORA_BASE_PATH=/
SUPABASE_URL=https://YOUR-DEV-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY
